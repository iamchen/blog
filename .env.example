# Notion 内部集成的密钥。只在本地或 GitHub Actions Secrets 中填写，不要提交真实值。
NOTION_TOKEN=

# 博客数据库 ID（Notion 页面 URL 里那串 32 位字符）。
NOTION_DATABASE_ID=bebc52b20a0d43639a76a4bef5c76efd

# 站点域名（不含路径）。GitHub Pages 用户站默认如下。
SITE_URL=https://iamchen.github.io

# 站点部署在域名下的路径。仓库名为 blog 时，线上地址是 https://iamchen.github.io/blog/
BASE_PATH=/blog
